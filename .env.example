# API (apps/api). Copy to `.env` at the repository root.
API_PORT=4000
API_HOST=127.0.0.1
DATABASE_PATH=./data/opskit.db
# Comma-separated origins allowed to send cookie-authenticated mutations.
ALLOWED_ORIGINS=http://localhost:3000
SESSION_TTL_HOURS=12
SESSION_COOKIE_NAME=opskit_session
# Set to true behind HTTPS.
SESSION_COOKIE_SECURE=false

# Demo seed (npm run seed). Use your own values; never reuse them in production.
DEMO_ADMIN_EMAIL=admin@example.com
DEMO_ADMIN_PASSWORD=change-me-please
DEMO_ORGANIZATION_NAME=Demo Organization

# Web (apps/web): where the Next.js server proxies /api/* requests.
API_INTERNAL_URL=http://127.0.0.1:4000
