{
  "name": "@opskit/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "REST v1 API. Thin HTTP handlers over the core use cases.",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/main.ts",
    "seed": "tsx --env-file-if-exists=../../.env src/seed.ts",
    "start": "node --env-file-if-exists=../../.env dist/main.js",
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.3",
    "@opskit/config": "0.1.0",
    "@opskit/contracts": "0.1.0",
    "@opskit/core": "0.1.0",
    "@opskit/sqlite": "0.1.0",
    "fastify": "5.12.5",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "tsup": "8.5.1",
    "tsx": "4.23.15"
  }
}
